{
  // Type-checks the root tests that import mobile code (and React Native) with
  // the mobile app's settings, so React Native's globals stay out of the web
  // typecheck. Run with `npm run typecheck:mobile-tests`.
  "extends": "../mobile/tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "mobile-calendar-sync.test.ts",
    "mobile-calendar-soft-ask-context.test.ts",
    "mobile-calendar-reconcile.test.ts",
    "mobile-optimistic-mutations.test.ts",
    "mobile-sign-out-cleanup.test.ts",
    "mobile-updates.test.ts",
    "mobile-resume-draft-preservation.test.ts",
    "mobile-reminder-notification-actions.test.ts",
    "mobile-task-priority-drag.test.ts",
    "mobile-complete-subtasks-prompt.test.ts",
    "android-app-links.test.ts",
    "widget-pinned-toggle.test.ts",
    "widget-progress-ring.test.ts",
    "widget-snapshot.test.ts",
    "widget-switch-list.test.ts",
    // Ambient module augmentations and `?raw` import types used by mobile code.
    "../mobile/src/types/expo-ui.d.ts",
    "../node_modules/vite/client.d.ts"
  ]
}
