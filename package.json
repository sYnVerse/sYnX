    "dash": true
  },
  "dependencies": {
    "@openauthjs/openauth": "^0.4.3",
    "@react-router/cloudflare": "^8.5.1",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20250404.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.18",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "check": "react-router typegen && tsc && react-router build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler d1 migrations apply synx-db --remote && wrangler deploy",
    "deploy:preview": "npm run build && wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc && wrangler preview",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --max-warnings 0 .",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "test:mobile": "vitest run test/mobile- test/android- test/widget- test/post-build-comment test/changelog-order",
    "typecheck": "react-router typegen && tsc",
    "typecheck:mobile-tests": "tsc -p test/tsconfig.mobile.json"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@humanfs/node": "^0.16.8",
    "body-parser": "^1.20.9",
    "browserslist": "^4.28.7",
    "estree-util-value-to-estree": "^3.3.3",
    "js-yaml": "^4.3.2",
    "miniflare": {
      "undici": "^7.30.1",
      "ws": "^8.21.0"
    },
    "nanoid": "^3.3.18",
    "postcss-modules-local-by-default": {
      "postcss-selector-parser": "^7.1.6"
    },
    "postcss-modules-scope": {
      "postcss-selector-parser": "^7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^6.1.5"
    },
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "tailwindcss": {
      "postcss-selector-parser": "^6.1.5"
    },
    "tar": "^7.5.21",
    "toml": "^5.0.1"
  },
  "sideEffects": false,
  "type": "module"
}
