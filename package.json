{
  "name": "to-do-list",
  "description": "A simple to-do list app built with Cloudflare Workers Assets and Remix.",
  "cloudflare": {
    "label": "To-Do List App",
    "products": [
      "Workers",
      "KV"
    ],
    "categories": [
      "storage"
    ],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/42c025ab-20bc-4bfe-2e7c-8660fba01600/public",
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "docs_url": "https://developers.cloudflare.com/kv/",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/923473bc-a285-487c-93db-e0ddea3d3700/public",
    "dash": true
  },
  "dependencies": {
    "@openauthjs/openauth": "^0.4.3",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20250404.0",
    "@eslint/js": "^9.39.5",
    "@remix-run/dev": "^2.17.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.95.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "remix vite:build",
    "cf-typegen": "wrangler types",
    "check": "tsc && remix vite:build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler d1 migrations apply synx-db --remote && wrangler deploy",
    "dev": "remix vite:dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "preview": "npm run build && wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "typecheck": "tsc",
    "typecheck:mobile-tests": "tsc -p test/tsconfig.mobile.json"
  },
  "overrides": {
    "estree-util-value-to-estree": "^3.3.3",
    "tar": "^7.5.11"
  },
  "sideEffects": false,
  "type": "module"
}
