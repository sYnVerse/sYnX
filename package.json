    "@remix-run/react": "^2.17.4",
    "@remix-run/server-runtime": "^2.17.4",
    "valibot": "^1.0.0-beta.9",
    "isbot": "5.1.26",
    "nanoid": "5.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
