    "@remix-run/dev": "^2.17.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "autoprefixer": "10.4.21",
    "eslint": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "5.1.4",
