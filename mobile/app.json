{
  "expo": {
    "name": "sYnX",
    "slug": "synx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "synx",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.christran.synx"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "io.christran.synx",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "synx.christran.io",
              "pathPrefix": "/mobile/callback"
            },
            {
              "scheme": "https",
              "host": "synx.christran.io",
              "pathPrefix": "/list"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow sYnX to access your calendar to sync your task reminders."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "cf164c52-5a77-472a-9120-768ab5499a2d"
      }
    },
    "owner": "chris-tran"
  }
}
