{
  "expo": {
    "name": "sYnX",
    "slug": "synx",
    "version": "3.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "synx",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.christran.synx"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "io.christran.synx",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "synx.christran.io",
              "pathPrefix": "/mobile/callback"
            },
            {
              "scheme": "https",
              "host": "synx.christran.io",
              "pathPrefix": "/list"
            },
            {
              "scheme": "https",
              "host": "synx.christran.io",
              "pathPattern": "/........-....-....-....-............"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow sYnX to access your calendar to sync your task reminders."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "CurrentListWidget",
              "displayName": "sYnX: Active List",
              "description": "View and check off tasks from your current sYnX list.",
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/CurrentListWidget.tsx"
              }
            },
            {
              "name": "PinnedListWidget",
              "displayName": "sYnX: Pinned List & Up Next",
              "description": "Keep your pinned list or Up Next reminders accessible on your home screen.",
              "android": {
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/PinnedListWidget.tsx"
              }
            },
            {
              "name": "ListProgressWidget",
              "displayName": "sYnX: Progress & Quick Add",
              "description": "Track task completion progress and quickly add new tasks.",
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/ListProgressWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetProgressRing"
    ],
    "extra": {
      "eas": {
        "projectId": "cf164c52-5a77-472a-9120-768ab5499a2d"
      }
    },
    "owner": "chris-tran"
  }
}
