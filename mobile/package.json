{
  "name": "synx-mobile",
  "version": "3.3.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-widgets.js",
    "prestart": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/patch-expo-widgets.js",
    "prebuild": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/patch-expo-widgets.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/decode-google-services.js",
    "sync-version": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-background-task": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.12",
    "expo-notifications": "~58.0.14",
    "expo-secure-store": "~58.0.9",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.23",
    "lucide-react-native": "^1.27.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.6.2",
    "valibot": "^1.0.0-rc.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
