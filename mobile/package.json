{
  "name": "synx-mobile",
  "version": "3.9.0",
  "license": "AGPL-3.0-or-later",
  "main": "expo/AppEntry.js",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-widgets.js",
    "prestart": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/patch-expo-widgets.js",
    "prebuild": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/patch-expo-widgets.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js && node ./scripts/decode-google-services.js",
    "sync-version": "node ./scripts/sync-shared.js && node ./scripts/sync-version.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "axios": "^1.21.0",
    "expo": "~58.0.25",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.18",
    "expo-background-task": "~58.0.13",
    "expo-blur": "~58.0.6",
    "expo-calendar": "~58.0.7",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "expo-widgets": "~58.0.28",
    "lucide-react-native": "^1.69.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1306.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.13.0",
    "typescript": "^5.7.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
