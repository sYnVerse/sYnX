{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "to-do-list",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2025-04-01",
  "upload_source_maps": true,
  "main": "./server.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/client"
  },
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synx-db",
      "database_id": "0201d5b3-1df0-4dfe-a47c-22bb1dd9f878",
      "migrations_dir": "migrations"
    }
  ],
  // Rate limit for writes by guests (not signed in) on lists shared as
  // "anyone can edit". Checked per guest id and per IP in
  // app/guest-access.server.ts. namespace_id must be unique in the account.
  "ratelimits": [
    {
      "name": "GUEST_WRITE_LIMITER",
      "namespace_id": "4201",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
