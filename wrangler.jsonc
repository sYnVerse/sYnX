{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "to-do-list",
  "compatibility_date": "2025-04-01",
  "upload_source_maps": true,
  "main": "./server.ts",
  "assets": {
    "directory": "./build/client"
  },
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synx-db",
      "database_id": "0201d5b3-1df0-4dfe-a47c-22bb1dd9f878"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
